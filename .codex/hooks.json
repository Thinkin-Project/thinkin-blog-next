{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/format-lint.js\"",
            "commandWindows": "node \".codex/hooks/format-lint.js\"",
            "statusMessage": "格式化已編輯的檔案並檢查 Lint",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
