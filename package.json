        "@tailwindcss/vite": "^4.2.2",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^25",
        "@vitest/coverage-v8": "^4.1.2",
        "bits-ui": "^2.17.2",
        "clsx": "^2.1.1",
